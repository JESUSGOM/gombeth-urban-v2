<title>Gombeth Software Solutions</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#f5f7fa;
    color:#333;
}

.hero{
    background:linear-gradient(135deg,#0f172a,#1e3a8a);
    color:white;
    text-align:center;
    padding:80px 20px;
}

.hero img{
    width:450px;
    max-width:90%;
    margin-bottom:30px;
}

.hero h1{
    font-size:48px;
    margin-bottom:15px;
}

.hero p{
    font-size:22px;
    margin-bottom:25px;
}

.btn{
    display:inline-block;
    background:#3b82f6;
    color:white;
    padding:14px 28px;
    border-radius:8px;
    text-decoration:none;
    font-weight:bold;
}

.container{
    width:90%;
    max-width:1400px;
    margin:auto;
    padding:60px 20px;
}

.card{
    background:white;
    border-radius:12px;
    padding:30px;
    margin-bottom:25px;
    box-shadow:0 5px 15px rgba(0,0,0,0.08);
}

h2{
    color:#1e3a8a;
    margin-bottom:20px;
}

ul{
    padding-left:20px;
}

li{
    margin-bottom:10px;
}

footer{
    background:#0f172a;
    color:white;
    text-align:center;
    padding:25px;
}

</style>

</head>

